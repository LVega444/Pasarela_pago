<UserControl x:Class="ProyectoSauna.UserControlCuentas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ProyectoSauna.ViewModels"
             Background="#14161C">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Estilo global para TextBox -->
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#4CC9F0"/>
            <Setter Property="BorderBrush" Value="#6B7280"/>
        </Style>
    </UserControl.Resources>
    
    <UserControl.DataContext>
        <vm:CuentasViewModel/>
    </UserControl.DataContext>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado Compacto -->
        <Border Grid.Row="0" Background="#1E2128" CornerRadius="8" Padding="15,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <materialDesign:PackIcon Grid.Column="0" Kind="Receipt" Width="28" Height="28" Foreground="#4CC9F0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Cuentas y Consumos" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Gestión de cuentas pendientes y nuevas entradas" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                </StackPanel>
                
                <!-- Contador de cuentas -->
                <Border Grid.Column="2" Background="#4CC9F022" CornerRadius="6" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClockOutline" Width="16" Height="16" Foreground="#4CC9F0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CuentasPendientes.Count, StringFormat='{}{0} pendientes'}" 
                                   Foreground="#4CC9F0" FontSize="12" FontWeight="Medium" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Contenido Principal: TABS RESPONSIVE -->
        <TabControl Grid.Row="1" 
                    Style="{StaticResource MaterialDesignFilledTabControl}"
                    Background="#1E2128"
                    materialDesign:ColorZoneAssist.Mode="PrimaryMid">
            
            <!-- TAB 1: GESTIÓN DE CUENTAS -->
            <TabItem Header="Gestión de Cuentas">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Receipt" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Gestión de Cuentas" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

            <!-- COLUMNA 1: Panel Izquierdo - Formulario Nueva Cuenta -->
            <Border Grid.Column="0" Background="#1E2128" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Título del formulario -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="AccountPlus" Width="18" Height="18" Foreground="#4CC9F0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Nueva Cuenta" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- DNI del Cliente -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="DNI del Cliente *" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4" FontWeight="Medium"/>
                            <TextBox x:Name="TxtDni" 
                                     Text="{Binding DniBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:HintAssist.Hint="8 dígitos"
                                     materialDesign:HintAssist.Foreground="#6B7280"
                                     materialDesign:HintAssist.IsFloating="False"
                                     materialDesign:TextFieldAssist.TextBoxViewMargin="1 0 1 0"
                                     Padding="12,10"
                                     MaxLength="8"
                                     FontSize="16"
                                     Height="42"
                                     PreviewTextInput="TextBox_NumerosSoloPreviewTextInput"/>
                            <TextBlock Text="Verificación: DNI debe tener exactamente 8 dígitos numéricos" 
                                       Foreground="#6B7280" 
                                       FontSize="9" 
                                       Margin="4,3,0,0"
                                       FontStyle="Italic"/>
                        </StackPanel>
                
                        <Button Command="{Binding BuscarClienteCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#4CC9F0"
                                BorderBrush="#4CC9F0"
                                Foreground="#14161C"
                                Height="38"
                                FontWeight="SemiBold"
                                FontSize="13"
                                Margin="0,8,0,16">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Buscar Cliente" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Info Cliente Encontrado -->
                        <Border Background="#4CC9F015" 
                                BorderBrush="#4CC9F0"
                                BorderThickness="1"
                                CornerRadius="6" 
                                Padding="12" 
                                Margin="0,0,0,16"
                                Visibility="{Binding ClienteEncontrado, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="CheckCircle" Width="16" Height="16" Foreground="#4CC9F0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="CLIENTE ENCONTRADO" FontWeight="Bold" Foreground="#4CC9F0" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding NombreClienteBuscado}" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Botones -->
                        <Button Command="{Binding CrearCuentaCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#4CC9F0"
                                BorderBrush="#4CC9F0"
                                Foreground="#14161C"
                                Height="38"
                                FontWeight="SemiBold"
                                FontSize="13"
                                Margin="0,0,0,8"
                                IsEnabled="{Binding ClienteEncontrado}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Crear Cuenta" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding LimpiarBusquedaCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="#6B7280"
                                Foreground="#9CA3AF"
                                Height="38"
                                FontWeight="Medium"
                                FontSize="13"
                                Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Limpiar" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Loading Indicator -->
                        <ProgressBar IsIndeterminate="True" 
                                     Height="3"
                                     Margin="0,8,0,16"
                                     Visibility="{Binding EstaCargando, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Información de Promociones -->
                        <Border Background="#252A34" 
                                BorderBrush="#4CC9F0"
                                BorderThickness="1"
                                CornerRadius="6" 
                                Padding="12" 
                                Margin="0,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="TagMultiple" Width="16" Height="16" Foreground="#4CC9F0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="PROGRAMA DE FIDELIZACIÓN" FontWeight="Bold" Foreground="#4CC9F0" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <TextBlock Foreground="#9CA3AF" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6">
                                    <Run Text="• Precio normal: " FontWeight="Medium"/>
                                    <Run Text="S/. 20.00 por entrada" Foreground="White"/>
                                </TextBlock>
                                
                                <TextBlock Foreground="#9CA3AF" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6">
                                    <Run Text="• A partir de la 5ta visita: " FontWeight="Medium"/>
                                    <Run Text="DESCUENTO ESPECIAL 🎉" Foreground="#4CC9F0" FontWeight="Bold"/>
                                </TextBlock>
                                
                                <TextBlock Foreground="#9CA3AF" FontSize="10" TextWrapping="Wrap">
                                    <Run Text="• Visitas con descuento: " FontWeight="Medium"/>
                                    <Run Text="5ta, 10ma, 15va, 20va..." Foreground="White"/>
                                </TextBlock>
                                
                                <Border Background="#4CC9F015" 
                                        CornerRadius="4" 
                                        Padding="8" 
                                        Margin="0,8,0,0">
                                    <TextBlock Foreground="#4CC9F0" FontSize="9" TextWrapping="Wrap" TextAlignment="Center">
                                        <Run Text="El descuento se aplica automáticamente según visitas acumuladas" FontStyle="Italic"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="* Campos obligatorios" 
                                   Foreground="#6B7280" 
                                   FontSize="10" 
                                   Margin="0,12,0,0"
                                   FontStyle="Italic"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- COLUMNA 2: Panel Central - Lista de Cuentas Pendientes -->
            <Border Grid.Column="2" Background="#1E2128" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Título de sección -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="ClipboardList" Width="18" Height="18" Foreground="#4CC9F0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Cuentas Pendientes" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        
                        <Button Grid.Column="2" 
                                Command="{Binding ActualizarListaCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Actualizar lista"
                                Width="32" Height="32">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Foreground="#4CC9F0"/>
                        </Button>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CuentasPendientes}"
                              SelectedItem="{Binding CuentaSeleccionada}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              RowBackground="#252A34"
                              AlternatingRowBackground="#2D3748"
                              Foreground="White"
                              FontSize="12"
                              BorderThickness="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="Background" Value="#1E2128"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="12,10"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Setter Property="Height" Value="40"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding idCuenta}" Width="50"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding NombreCliente}" Width="180"/>
                            <DataGridTextColumn Header="DNI" Binding="{Binding DocumentoCliente}" Width="90"/>
                            <DataGridTextColumn Header="Hora" Binding="{Binding HoraIngreso}" Width="80"/>
                            <DataGridTextColumn Header="Tiempo" Binding="{Binding TiempoTranscurrido}" Width="90"/>
                            <DataGridTextColumn Header="Precio" Binding="{Binding precioEntrada, StringFormat=S/. {0:0.00}}" Width="80"/>
                            <DataGridTextColumn Header="Descuento" Binding="{Binding descuento, StringFormat=S/. {0:0.00}}" Width="85"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding total, StringFormat=S/. {0:0.00}}" Width="80"/>
                            <DataGridTextColumn Header="Saldo" Binding="{Binding saldo, StringFormat=S/. {0:0.00}}" Width="80"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding EstadoCuenta}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: GESTIÓN DE CONSUMOS -->
            <TabItem Header="Gestión de Consumos">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CartOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Gestión de Consumos" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                            <Border Background="#4CC9F022" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="NUEVO" FontSize="9" FontWeight="Bold" Foreground="#4CC9F0"/>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: Selección de Productos -->
            <Border Grid.Column="0" Background="#252A34" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Título -->
                        <RowDefinition Height="Auto"/>  <!-- Info Cuenta Activa -->
                        <RowDefinition Height="Auto"/>  <!-- Búsqueda Producto -->
                        <RowDefinition Height="*"/>     <!-- Lista Productos -->
                        <RowDefinition Height="Auto"/>  <!-- Agregar -->
                        <RowDefinition Height="200"/>   <!-- Consumos Actuales -->
                        <RowDefinition Height="Auto"/>  <!-- Total -->
                    </Grid.RowDefinitions>

                    <!-- Título Sección Consumos -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="CartOutline" Width="18" Height="18" Foreground="#4CC9F0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Gestión de Consumos" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Info Cuenta Activa Seleccionada -->
                    <Border Grid.Row="1" 
                            Background="#4CC9F015" 
                            BorderBrush="#4CC9F0" 
                            BorderThickness="1"
                            CornerRadius="6" 
                            Padding="12,10" 
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="CUENTA SELECCIONADA" 
                                       FontSize="9" 
                                       FontWeight="Bold" 
                                       Foreground="#4CC9F0" 
                                       Margin="0,0,0,6"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="ID:" FontSize="10" Foreground="#9CA3AF"/>
                                    <TextBlock Text="{Binding CuentaSeleccionada.idCuenta}" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               Foreground="#4CC9F0"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding CuentaSeleccionada.NombreCliente}" 
                                               FontSize="13" 
                                               FontWeight="SemiBold" 
                                               Foreground="White"/>
                                    <TextBlock FontSize="11" Foreground="#9CA3AF">
                                        <Run Text="DNI:"/>
                                        <Run Text="{Binding CuentaSeleccionada.DocumentoCliente}" FontWeight="Medium" Foreground="White"/>
                                        <Run Text=" | Hora:"/>
                                        <Run Text="{Binding CuentaSeleccionada.HoraIngreso}" FontWeight="Medium" Foreground="White"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Búsqueda de Producto -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="Buscar Producto" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4" FontWeight="Medium"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0"
                                     x:Name="TxtBuscarProducto"
                                     materialDesign:HintAssist.Hint="Nombre del producto..."
                                     materialDesign:HintAssist.Foreground="#6B7280"
                                     materialDesign:HintAssist.IsFloating="False"
                                     Padding="12,10"
                                     FontSize="13"
                                     Height="38"/>
                            
                            <Button Grid.Column="2"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="38" Height="38"
                                    Background="#4CC9F022"
                                    ToolTip="Buscar">
                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="#4CC9F0"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Lista de Productos Disponibles -->
                    <Border Grid.Row="3" 
                            Background="#252A34" 
                            CornerRadius="6" 
                            BorderBrush="#6B7280" 
                            BorderThickness="1"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header Productos -->
                            <Border Grid.Row="0" Background="#1E2128" Padding="10,8" BorderBrush="#6B7280" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="PRODUCTOS DISPONIBLES" 
                                               FontSize="10" 
                                               FontWeight="Bold" 
                                               Foreground="#9CA3AF"/>
                                    <TextBlock Text="Stock" 
                                               FontSize="10" 
                                               FontWeight="Bold" 
                                               Foreground="#9CA3AF"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            
                            <!-- ListBox de Productos -->
                            <ListBox Grid.Row="1"
                                     x:Name="ListProductos"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <!-- ItemsSource="{Binding ProductosDisponibles}" -->
                                <!-- SelectedItem="{Binding ProductoSeleccionado}" -->
                                
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#4CC9F022"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4CC9F011"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding nombre}" 
                                                           FontSize="12" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="White"/>
                                                <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0">
                                                    <Run Text="S/."/>
                                                    <Run Text="{Binding precio, StringFormat={}{0:0.00}}" FontWeight="Medium" Foreground="#4CC9F0"/>
                                                </TextBlock>
                                            </StackPanel>
                                            
                                            <Border Grid.Column="1" 
                                                    Background="#4CC9F022" 
                                                    CornerRadius="4" 
                                                    Padding="8,4"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding stock, StringFormat={}Stock: {0}}" 
                                                           FontSize="10" 
                                                           FontWeight="Medium" 
                                                           Foreground="#4CC9F0"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                
                                <!-- Datos de ejemplo (temporal) -->
                                <ListBoxItem>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Coca Cola 500ml" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0">
                                                <Run Text="S/."/>
                                                <Run Text="3.50" FontWeight="Medium" Foreground="#4CC9F0"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#4CC9F022" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="Stock: 45" FontSize="10" FontWeight="Medium" Foreground="#4CC9F0"/>
                                        </Border>
                                    </Grid>
                                </ListBoxItem>
                                
                                <ListBoxItem>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Cerveza Pilsen" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0">
                                                <Run Text="S/."/>
                                                <Run Text="7.00" FontWeight="Medium" Foreground="#4CC9F0"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#4CC9F022" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="Stock: 28" FontSize="10" FontWeight="Medium" Foreground="#4CC9F0"/>
                                        </Border>
                                    </Grid>
                                </ListBoxItem>
                                
                                <ListBoxItem>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Agua Mineral" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0">
                                                <Run Text="S/."/>
                                                <Run Text="2.00" FontWeight="Medium" Foreground="#4CC9F0"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#4CC9F022" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="Stock: 62" FontSize="10" FontWeight="Medium" Foreground="#4CC9F0"/>
                                        </Border>
                                    </Grid>
                                </ListBoxItem>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Cantidad y Botón Agregar -->
                    <Grid Grid.Row="4" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                   Text="Cantidad:" 
                                   FontSize="12" 
                                   Foreground="#9CA3AF" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"/>
                        
                        <TextBox Grid.Column="1"
                                 x:Name="TxtCantidad"
                                 Text="1"
                                 TextAlignment="Center"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Height="38"
                                 VerticalContentAlignment="Center"
                                 PreviewTextInput="TextBox_NumerosSoloPreviewTextInput"/>
                        
                        <Button Grid.Column="3"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#4CC9F0"
                                Height="38"
                                FontWeight="SemiBold">
                            <!-- Command="{Binding AgregarConsumoCommand}" -->
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="AGREGAR A CUENTA" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Consumos Actuales de la Cuenta -->
                    <Border Grid.Row="5" 
                            Background="#252A34" 
                            CornerRadius="6" 
                            BorderBrush="#6B7280" 
                            BorderThickness="1"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header Consumos -->
                            <Border Grid.Row="0" Background="#1E2128" Padding="10,8" BorderBrush="#6B7280" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="CONSUMOS ACTUALES" 
                                               FontSize="10" 
                                               FontWeight="Bold" 
                                               Foreground="#9CA3AF"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CartCheck" Width="14" Height="14" Foreground="#4CC9F0" VerticalAlignment="Center"/>
                                        <TextBlock Text="3 items" 
                                                   FontSize="10" 
                                                   FontWeight="Bold" 
                                                   Foreground="#4CC9F0"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <!-- DataGrid Consumos -->
                            <DataGrid Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="Transparent"
                                      RowBackground="#2D3748"
                                      AlternatingRowBackground="#252A34"
                                      Foreground="White"
                                      FontSize="11"
                                      BorderThickness="0">
                                <!-- ItemsSource="{Binding ConsumosActuales}" -->
                                
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                    </Style>
                                </DataGrid.CellStyle>
                                
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Height" Value="32"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                                    <DataGridTextColumn Header="Cant" Binding="{Binding cantidad}" Width="40"/>
                                    <DataGridTextColumn Header="P.Unit" Binding="{Binding precioUnitario, StringFormat=S/. {0:0.00}}" Width="60"/>
                                    <DataGridTextColumn Header="Subtotal" Binding="{Binding subtotal, StringFormat=S/. {0:0.00}}" Width="70"/>
                                    
                                    <DataGridTemplateColumn Header="" Width="32">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Width="24" Height="24"
                                                        ToolTip="Eliminar"
                                                        Padding="0">
                                                    <!-- Command="{Binding DataContext.EliminarConsumoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" -->
                                                    <!-- CommandParameter="{Binding idDetalle}" -->
                                                    <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Foreground="#EF4444"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Total General -->
                    <Border Grid.Row="6" 
                            Background="#4CC9F022" 
                            BorderBrush="#4CC9F0" 
                            BorderThickness="2"
                            CornerRadius="6" 
                            Padding="16,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Desglose -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4">
                                        <Run Text="Entrada:"/>
                                        <Run Text="S/. 20.00" FontWeight="Medium" Foreground="White"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4">
                                        <Run Text="Descuento:"/>
                                        <Run Text="- S/. 0.00" FontWeight="Medium" Foreground="White"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="#9CA3AF">
                                        <Run Text="Consumos:"/>
                                        <Run Text="+ S/. 12.50" FontWeight="Medium" Foreground="#4CC9F0"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Total -->
                            <Border Grid.Row="1" 
                                    Background="#14161C" 
                                    CornerRadius="4" 
                                    Padding="12,8">
                                <Grid>
                                    <TextBlock Text="TOTAL A PAGAR" 
                                               FontSize="11" 
                                               FontWeight="Bold" 
                                               Foreground="#9CA3AF"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="S/. 32.50" 
                                               FontSize="24" 
                                               FontWeight="Bold" 
                                               Foreground="#4CC9F0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
                    
            <!-- PANEL DERECHO: Consumos Actuales y Total -->
            <Border Grid.Column="2" Background="#1E2128" CornerRadius="8" Padding="16">
                <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Título -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="CartCheck" Width="18" Height="18" Foreground="#4CC9F0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Resumen de Cuenta" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Aquí iría el DataGrid de consumos actuales -->
                            <Border Grid.Row="1" Background="#252A34" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                <TextBlock Text="Selecciona una cuenta pendiente para gestionar sus consumos" 
                                           TextWrapping="Wrap"
                                           Foreground="#6B7280" 
                                           FontSize="13" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                            
                            <!-- Total idéntico al Tab 1 -->
                            <Border Grid.Row="2" 
                                    Background="#4CC9F022" 
                                    BorderBrush="#4CC9F0" 
                                    BorderThickness="2"
                                    CornerRadius="6" 
                                    Padding="16,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4">
                                                <Run Text="Entrada:"/>
                                                <Run Text="S/. 20.00" FontWeight="Medium" Foreground="White"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4">
                                                <Run Text="Descuento:"/>
                                                <Run Text="- S/. 0.00" FontWeight="Medium" Foreground="White"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="#9CA3AF">
                                                <Run Text="Consumos:"/>
                                                <Run Text="+ S/. 12.50" FontWeight="Medium" Foreground="#4CC9F0"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <Border Grid.Row="1" 
                                            Background="#14161C" 
                                            CornerRadius="4" 
                                            Padding="12,8">
                                        <Grid>
                                            <TextBlock Text="TOTAL A PAGAR" 
                                                       FontSize="11" 
                                                       FontWeight="Bold" 
                                                       Foreground="#9CA3AF"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="S/. 32.50" 
                                                       FontSize="24" 
                                                       FontWeight="Bold" 
                                                       Foreground="#4CC9F0"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
